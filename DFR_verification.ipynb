    "\n",
    "\n",
    "# DFR is computed from the noise BEFORE the PBS even starts!\n",
    "\n",
    "def p_dec_fail_log2(var_x,q_x,t_x):\n",
    "    noise_threshold = (q_x/(2*t_x)) # delta\n",
    "    # variance = sigma^2 --> sigma = sqrt(var)\n",
    "    failure_probability = erfc(noise_threshold/((var_x*2)**0.5)) # erfc = 1- erf\n",
    "    #return log(failure_probability,2)\n",
    "    return math.log(failure_probability, 2)\n",
    "\n",
    "def var_mod_switch(var_in, q_, N_):\n",
    "    new_q=2*N_\n",
    "    var_ms_ = (new_q**2)*var_in/(q_**2) + (1/12) - (new_q**2)/(12*(q_**2)) + (n/24) + (n*new_q**2/(48*q_**2))\n",
    "    return var_ms_\n",
    "\n",
    "def var_key_switch(var_in, N_, q_, beta_, var_bsk_, L_): # variance after keyswitch, before modulus switch\n",
    "    # assume binary key --> Var(s)=1/4, E(s)=1/2\n",
    "    var_s = 1/4\n",
    "    e_s=1/2\n",
    "    var_ksk = var_bsk_ # since its also rlwe\n",
    "    var_ks_ = var_in + N_ * (q_**2 - beta_**(2*L_)) / (12*beta_**(2*L_)) * (var_s + e_s**2) + (N_/4) * var_s + N_*L_ * var_ksk * (beta_**2 + 2) / 12\n",
    "    return var_ks_\n",
    "\n",
    "def var_pbs_op(var_bsk, n_, L_, k_, N_, beta_, q_): # this is the variance AFTER the PBS\n",
    "    # four components\n",
    "    comp1 = n_*L_*(k_+1)*N_*((beta_**(2) + 2)/12)*var_bsk\n",
    "    comp2 = n_*(((q_**2 - beta_**(2*L_))/(24*beta_**(2*L_)))*(1+k_*N_/2))\n",
    "    comp3 = n_*k_*N_/32\n",
    "    comp4 = (n_/16)*(1-k_*N_/2)**2\n",
    "    var_pbs_res = comp1 + comp2 + comp3 + comp4\n",
    "    return var_pbs_res\n",
    "\n",
    "def fft_extra_variance(k_,N_,beta_,L_,q_):\n",
    "    w_=19.4 # only valid for 64-bit implementations, so we add q_/(2**64) to rescale\n",
    "    num = (2**w_)*L_*(beta_**2)*(N_**2)*(k_+1)*(q_/(2**64))\n",
    "    return num\n",
    "\n",
    "print(\"Note: we are not considering FFT-introduced noise here\")\n",
    "\n",
    "for param_set in param_set_list:\n",
    "    n = param_set[\"n\"]\n",
    "    N = param_set[\"N\"]\n",
    "    k = param_set[\"k\"]\n",
    "    L = param_set[\"L\"]\n",
    "    log2_beta = param_set[\"log2_beta\"]\n",
    "    q = param_set[\"q\"]\n",
    "    bk_stdev = param_set[\"bk_stdev\"]\n",
    "    lwe_stdev = param_set[\"lwe_stdev\"]\n",
    "    log2_message_space_modulus = param_set[\"log2_message_space_modulus\"]\n",
    "    log2_carry_space_modulus = param_set[\"log2_carry_space_modulus\"]\n",
    "    ks_L = param_set[\"ks_L\"]\n",
    "    ks_log2_beta = param_set[\"ks_log2_beta\"]\n",
    "    padding_bit = 1\n",
    "\n",
    "    t_x = 2**(log2_message_space_modulus+log2_carry_space_modulus+padding_bit) # carry_space*msg_space*2 (*2 because of padding bit)\n",
    "    ks_beta = 2**ks_log2_beta\n",
    "    beta = 2**log2_beta\n",
    "    var_bsk = (bk_stdev*q)**2 # *q to rescale fraction of a torus to integer\n",
    "    #fft_noise = fft_extra_variance(k,N,beta,L,q)\n",
    "\n",
    "    var_pbs = var_pbs_op(var_bsk,n,L,k,N,beta,q) #+ fft_noise\n",
    "    var_lwe_in = var_pbs#(lwe_stdev*q)**2 # for chained operations var_lwe_in is the variance of the output of a PBS\n",
    "    var_ksk = (lwe_stdev*q)**2\n",
    "    var_ks = var_key_switch(var_lwe_in,k*N,q,ks_beta,var_ksk,ks_L)\n",
    "    var_mod_sw = var_mod_switch(var_ks,q,N) # variance of the noise before the PBS, this is the noise from modulus switch lwe-->rlwe\n",
    "    p_fail = p_dec_fail_log2(var_mod_sw,2*N,t_x)\n",
    "    print(\"param set: \" + param_set[\"name\"] + \" DFR calculated as: \" + str(p_fail))\n",
    "\n",
    "    q=R(2**64-2**32+1)\n",
    "    t_x = 2**(log2_message_space_modulus+log2_carry_space_modulus+padding_bit) # carry_space*msg_space*2 (*2 because of padding bit)\n",
    "    ks_beta = 2**ks_log2_beta\n",
    "    beta = 2**log2_beta\n",
    "    var_bsk = (bk_stdev*q)**2 # *q to rescale fraction of a torus to integer\n",
    "    #fft_noise = fft_extra_variance(k,N,beta,L,q)\n",
    "\n",
    "    var_pbs = var_pbs_op(var_bsk,n,L,k,N,beta,q) #+ fft_noise\n",
    "    var_lwe_in = var_pbs#(lwe_stdev*q)**2 # for chained operations var_lwe_in is the variance of the output of a PBS\n",
    "    var_ksk = (lwe_stdev*q)**2\n",
    "    var_ks = var_key_switch(var_lwe_in,k*N,q,ks_beta,var_ksk,ks_L)\n",
    "    var_mod_sw = var_mod_switch(var_ks,q,N) # variance of the noise before the PBS, this is the noise from modulus switch lwe-->rlwe\n",
    "    p_fail = p_dec_fail_log2(var_mod_sw,2*N,t_x)\n",
    "    print(\"param set: \" + param_set[\"name\"] + \" DFR_ calculated as: \" + str(p_fail))\n",
    "\n",
